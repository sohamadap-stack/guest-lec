# Backend config — copy to .env and fill in
PORT=5001
JWT_SECRET=dev_secret_change_me
# Get key from MiniMoth dashboard: Project → Settings (format mm_live_...)
# If left as placeholder, server runs in MOCK mode (OTP logged to console, use 123456 or console code)
MINIMOTH_API_KEY=mm_live_paste_your_key_here
MINIMOTH_BASE_URL=https://api.minimoth.dev
FRONTEND_URL=http://localhost:5173
